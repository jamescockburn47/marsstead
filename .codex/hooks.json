{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hook-guard-marsdata.mjs",
            "timeout": 10,
            "statusMessage": "Guarding generated marsdata.js"
          }
        ]
      }
    ]
  }
}
